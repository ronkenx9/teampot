{
  "name": "teampot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/local.ts",
    "typecheck": "tsc --noEmit && cd web && npx tsc --noEmit",
    "test": "vitest run",
    "build": "cd web && npm install && npm run build",
    "start": "tsx server/local.ts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:passkey": "tsx scripts/e2e-passkey.ts",
    "check:banned": "node scripts/check-banned-ui.mjs",
    "responsive": "node scripts/responsive-check.mjs",
    "landing": "node scripts/landing-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@vercel/blob": "^2.8.1",
    "dotenv": "^18.0.1",
    "hono": "^4.13.13",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}

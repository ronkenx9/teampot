{
  "name": "teampot-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "screenshot:sam": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/screenshot-sam.mjs",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "check:release": "node scripts/check-release.mjs",
    "test:sessions": "node --import ../app/node_modules/tsx/dist/loader.mjs scripts/session-tests.ts",
    "test:beta": "expo export --platform web --output-dir dist-beta && node scripts/beta-smoke.mjs",
    "test:profiles": "node --import ../app/node_modules/tsx/dist/loader.mjs scripts/profile-tests.ts"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.30",
    "expo-blur": "~57.0.3",
    "expo-constants": "^57.0.21",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "57.0.3",
    "expo-router": "~58.0.25",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "playwright": "^1.64.0",
    "typescript": "~6.0.3"
  }
}

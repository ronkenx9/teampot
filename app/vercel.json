{
  "installCommand": "npm install && cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/join/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tour",
      "destination": "/index.html"
    },
    {
      "source": "/waitlist",
      "destination": "/index.html"
    },
    {
      "source": "/stats",
      "destination": "/index.html"
    }
  ],
  "fluid": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/join/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
